<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://tizen.org/ns/packages"
          api-version="10.0"
          package="com.example.openclaw_tv_genui"
          version="1.0.0">
  <profile name="tv" />
  <ui-application appid="com.example.openclaw_tv_genui"
                  exec="Runner.dll"
                  type="dotnet"
                  multiple="false"
                  taskmanage="true"
                  launch_mode="single">
    <label>OpenClaw TV</label>
    <app-control>
      <operation name="http://tizen.org/appcontrol/operation/default" />
    </app-control>
    <metadata key="http://tizen.org/metadata/prefer_dotnet_aot"
              value="true" />
    <metadata key="http://tizen.org/metadata/prefer_nuget_cache"
              value="true" />
  </ui-application>
  <privileges>
    <privilege>http://tizen.org/privilege/mediastorage</privilege>
    <privilege>http://tizen.org/privilege/externalstorage</privilege>
  </privileges>
</manifest>
